<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Smiley Face Army</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #0d0d0d;
    color: white;
}

header {
    background: #181818;
    padding: 20px;
    text-align: center;
    border-bottom: 3px solid #00ff88;
}

.logo {
    font-size: 50px;
    font-weight: bold;
    color: #00ff88;
}

header h1 {
    margin: 5px;
}

.buttons {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    padding: 20px;
}

button {
    background: #181818;
    color: white;
    border: 2px solid #00ff88;
    border-radius: 8px;
    padding: 12px 20px;
    cursor: pointer;
    font-weight: bold;
}

button:hover {
    background: #00ff88;
    color: black;
}

.panel {
    display: none;
    max-width: 1000px;
    margin: auto;
    padding: 20px;
}

.panel.active {
    display: block;
}

/* STOCK MARKET */

.market-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
}

.balance-box {
    background: #181818;
    border: 2px solid #00ff88;
    padding: 15px;
    border-radius: 10px;
}

.balance {
    color: #00ff88;
    font-size: 22px;
    font-weight: bold;
}

.status {
    text-align: center;
    color: #888;
    margin: 15px 0;
}

.stock-card {
    background: #151515;
    border: 1px solid #333;
    border-radius: 14px;
    margin: 20px 0;
    padding: 20px;
}

.stock-title {
    font-size: 23px;
    font-weight: bold;
}

.ticker {
    color: #888;
    font-size: 15px;
}

.description {
    color: #aaa;
    margin-top: 5px;
}

.stock-price {
    font-size: 32px;
    font-weight: bold;
    margin-top: 15px;
}

.stock-change {
    font-weight: bold;
    margin: 5px 0 10px;
}

.up {
    color: #00ff88;
}

.down {
    color: #ff4d4d;
}

/* CHART */

.chart-container {
    width: 100%;
    height: 230px;
    background: #090909;
    border-radius: 10px;
    overflow: hidden;
    margin-top: 15px;
}

canvas {
    width: 100%;
    height: 100%;
    display: block;
}

/* NPC ACTIVITY */

.npc-market {
    background: #101010;
    border-radius: 8px;
    padding: 14px;
    margin-top: 15px;
    line-height: 1.8;
}

.buying {
    color: #00ff88;
}

.selling {
    color: #ff4d4d;
}

.neutral {
    color: #aaa;
}

.actions {
    margin-top: 15px;
}

.actions button {
    margin-right: 8px;
}

.shares {
    color: #bbb;
}

/* OTHER PANELS */

.info-box {
    background: #181818;
    border: 1px solid #333;
    border-radius: 10px;
    padding: 20px;
    margin-top: 15px;
}
</style>
</head>

<body>

<header>
    <div class="logo">&gt;:)</div>
    <h1>THE SMILEY FACE ARMY</h1>
    <p>Organization Command HQ</p>
</header>

<div class="buttons">
    <button onclick="openPanel('team')">TEAM</button>
    <button onclick="openPanel('map')">MAP</button>
    <button onclick="openPanel('action')">ACTION</button>
    <button onclick="openPanel('stocks')">STOCKS</button>
    <button onclick="openPanel('command')">COMMAND CENTER</button>
</div>

<!-- TEAM -->

<div id="team" class="panel">
    <h2>TEAM</h2>

    <div class="info-box">
        <p>Organization members, teams and ranks.</p>
    </div>
</div>

<!-- MAP -->

<div id="map" class="panel">
    <h2>MAP</h2>

    <div class="info-box">
        <p>🌎 World Map</p>
        <p>🕳️ Underground Map</p>
    </div>
</div>

<!-- ACTION -->

<div id="action" class="panel">
    <h2>ACTION</h2>

    <div class="info-box">
        <p>Fictional world simulation.</p>
        <p>More actions coming soon...</p>
    </div>
</div>

<!-- STOCKS -->

<div id="stocks" class="panel">

    <div class="market-header">
        <h2>📈 SFA STOCK EXCHANGE</h2>

        <div class="balance-box">
            💰 Smiley Dollars:
            <div class="balance" id="balance">
                $10,000.00
            </div>
        </div>
    </div>

    <div class="status">
        🔴 LIVE MARKET — NPC investors trade every second
    </div>

    <div id="stock-list"></div>

</div>

<!-- COMMAND CENTER -->

<div id="command" class="panel">

    <h2>COMMAND CENTER</h2>

    <div class="info-box">
        <p>🫡 Commander communication system.</p>
        <p>Promotion requests coming soon.</p>
    </div>

</div>


<script>

/* ==========================================
   STOCK DATA
========================================== */

const stocks = {

    ADI: {
        name: "AeroDyne Industries",
        description: "Aircraft, aviation systems and flight gear",
        price: 120
    },

    ICD: {
        name: "Ironclad Dynamics",
        description: "Armored vehicles and equipment",
        price: 85
    },

    NEX: {
        name: "Nexora Industries",
        description: "Everyday products and consumer goods",
        price: 64
    },

    SFC: {
        name: "Stellar Frontier Corp.",
        description: "Spacecraft, satellites and space equipment",
        price: 210
    }

};


/* ==========================================
   PLAYER
========================================== */

let balance = 10000;

const shares = {
    ADI: 0,
    ICD: 0,
    NEX: 0,
    SFC: 0
};


/* ==========================================
   PRICE HISTORY
========================================== */

const history = {};

for (const ticker in stocks) {

    history[ticker] = [];

    for (let i = 0; i < 60; i++) {

        history[ticker].push(
            stocks[ticker].price
        );

    }

}


/* ==========================================
   NPC MARKET DATA
========================================== */

const npcData = {};

for (const ticker in stocks) {

    npcData[ticker] = {
        buyers: 0,
        sellers: 0
    };

}


/* ==========================================
   OPEN PANELS
========================================== */

function openPanel(panelName) {

    document
        .querySelectorAll(".panel")
        .forEach(panel => {

            panel.classList.remove("active");

        });

    const panel =
        document.getElementById(panelName);

    if (panel) {
        panel.classList.add("active");
    }

}


/* ==========================================
   MONEY
========================================== */

function money(value) {

    return "$" + value.toLocaleString(
        "en-US",
        {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        }
    );

}


/* ==========================================
   DRAW STOCK CHART
========================================== */

function drawChart(canvas, prices) {

    const ctx =
        canvas.getContext("2d");

    const width =
        canvas.clientWidth;

    const height =
        canvas.clientHeight;

    const pixelRatio =
        window.devicePixelRatio || 1;

    canvas.width =
        width * pixelRatio;

    canvas.height =
        height * pixelRatio;

    ctx.setTransform(
        pixelRatio,
        0,
        0,
        pixelRatio,
        0,
        0
    );

    ctx.clearRect(
        0,
        0,
        width,
        height
    );


    if (prices.length < 2) {
        return;
    }


    let min =
        Math.min(...prices);

    let max =
        Math.max(...prices);

    let range =
        max - min;


    if (range === 0) {
        range = 1;
    }


    /*
       Draw faint horizontal
       reference lines.
    */

    ctx.strokeStyle = "#222";
    ctx.lineWidth = 1;

    for (let i = 1; i < 5; i++) {

        const y =
            (height / 5) * i;

        ctx.beginPath();

        ctx.moveTo(0, y);
        ctx.lineTo(width, y);

        ctx.stroke();

    }


    /*
       Draw stock line.
    */

    ctx.beginPath();


    prices.forEach((price, index) => {

        const x =
            (index / (prices.length - 1))
            * width;

        const y =
            height -
            ((price - min) / range)
            * (height - 20)
            - 10;


        if (index === 0) {

            ctx.moveTo(x, y);

        } else {

            ctx.lineTo(x, y);

        }

    });


    const first =
        prices[0];

    const last =
        prices[prices.length - 1];


    if (last >= first) {

        ctx.strokeStyle =
            "#00ff88";

    } else {

        ctx.strokeStyle =
            "#ff4d4d";

    }


    ctx.lineWidth = 3;

    ctx.stroke();

}


/* ==========================================
   RENDER STOCKS
========================================== */

function renderStocks() {

    const container =
        document.getElementById("stock-list");


    container.innerHTML = "";


    for (const ticker in stocks) {

        const stock =
            stocks[ticker];

        const currentPrice =
            stock.price;

        const firstPrice =
            history[ticker][0];


        const percent =
            ((currentPrice - firstPrice)
            / firstPrice) * 100;


        const direction =
            percent >= 0
            ? "▲"
            : "▼";


        const colorClass =
            percent >= 0
            ? "up"
            : "down";


        const buyers =
            npcData[ticker].buyers;

        const sellers =
            npcData[ticker].sellers;


        let marketPressure;


        if (buyers > sellers) {

            marketPressure =
                '<span class="buying">BUYING PRESSURE 📈</span>';

        } else if (sellers > buyers) {

            marketPressure =
                '<span class="selling">SELLING PRESSURE 📉</span>';

        } else {

            marketPressure =
                '<span class="neutral">MARKET NEUTRAL</span>';

        }


        const card =
            document.createElement("div");


        card.className =
            "stock-card";


        card.innerHTML = `

            <div class="stock-title">
                ${stock.name}
                <span class="ticker">
                    (${ticker})
                </span>
            </div>

            <div class="description">
                ${stock.description}
            </div>

            <div class="stock-price">
                ${money(currentPrice)}
            </div>

            <div class="stock-change ${colorClass}">
                ${direction}
                ${Math.abs(percent).toFixed(2)}%
            </div>

            <div class="chart-container">
                <canvas></canvas>
            </div>

            <div class="npc-market">

                👥 <b>NPC MARKET ACTIVITY</b>

                <br>

                🟢 Buyers:
                <span class="buying">
                    ${buyers.toLocaleString()}
                </span>

                <br>

                🔴 Sellers:
                <span class="selling">
                    ${sellers.toLocaleString()}
                </span>

                <br>

                ⚖️ Market:
                ${marketPressure}

                <br>

                <span class="shares">
                    👤 Your shares: ${shares[ticker]}
                </span>

            </div>

            <div class="actions">

                <button
                    onclick="buyStock('${ticker}')">
                    BUY 1
                </button>

                <button
                    onclick="sellStock('${ticker}')">
                    SELL 1
                </button>

            </div>
        `;


        container.appendChild(card);


        const canvas =
            card.querySelector("canvas");


        drawChart(
            canvas,
            history[ticker]
        );

    }


    document.getElementById("balance")
        .textContent = money(balance);

}


/* ==========================================
   NPC MARKET UPDATE
========================================== */

function updateMarket() {

    for (const ticker in stocks) {

        /*
           Simulated world population.

           These are fictional NPC investors.
        */

        const buyers =
            Math.floor(
                400000 +
                Math.random() * 600000
            );


        const sellers =
            Math.floor(
                400000 +
                Math.random() * 600000
            );


        npcData[ticker].buyers =
            buyers;

        npcData[ticker].sellers =
            sellers;


        /*
           Calculate buying/selling pressure.
        */

        const difference =
            buyers - sellers;


        /*
           Convert NPC activity into
           a small price movement.
        */

        const movement =
            difference / 100000000;


        stocks[ticker].price +=
            stocks[ticker].price
            * movement;


        /*
           Don't allow a stock to
           fall below $1.
        */

        if (stocks[ticker].price < 1) {

            stocks[ticker].price = 1;

        }


        /*
           Save new price to chart.
        */

        history[ticker].push(
            stocks[ticker].price
        );


        /*
           Keep the latest 60 seconds.
        */

        if (history[ticker].length > 60) {

            history[ticker].shift();

        }

    }


    renderStocks();

}


/* ==========================================
   BUY STOCK
========================================== */

function buyStock(ticker) {

    const price =
        stocks[ticker].price;


    if (balance < price) {

        alert(
            "Not enough Smiley Dollars!"
        );

        return;

    }


    balance -= price;

    shares[ticker]++;


    /*
       Your purchase creates
       a tiny amount of demand.
    */

    stocks[ticker].price *= 1.0005;


    history[ticker].push(
        stocks[ticker].price
    );


    if (history[ticker].length > 60) {

        history[ticker].shift();

    }


    renderStocks();

}


/* ==========================================
   SELL STOCK
========================================== */

function sellStock(ticker) {

    if (shares[ticker] <= 0) {

        alert(
            "You don't own this stock!"
        );

        return;

    }


    const price =
        stocks[ticker].price;


    balance += price;

    shares[ticker]--;


    /*
       Your sale creates
       a tiny amount of selling pressure.
    */

    stocks[ticker].price *= 0.9995;


    history[ticker].push(
        stocks[ticker].price
    );


    if (history[ticker].length > 60) {

        history[ticker].shift();

    }


    renderStocks();

}


/* ==========================================
   START MARKET
========================================== */

renderStocks();

setInterval(
    updateMarket,
    1000
);


/* ==========================================
   OPEN STOCK MARKET
========================================== */

openPanel("stocks");

</script>

</body>
</html>
